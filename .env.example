# Local SQLite works without a Turso account. Never use file: on Vercel.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
APP_URL=http://localhost:3000
# Run npm run setup:local to generate local secrets.
EVENT_INGEST_API_KEY=
OAUTH_SIGNING_SECRET=
OWNER_PASSWORD_HASH=
# Exact comma-separated callbacks; copy the value shown by ChatGPT when connecting.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
